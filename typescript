export const getRange = query({
  date: 'date',
  year: 'year',
  month: 'month',
  day: 'day',
  week: 'week',
  hour: 'hour',
  minute: 'minute',
  second: 'second',
  timezone: 'timezone',
});

export const getYearlyStats = (logs, timetableCounts) => {
  const statsByDate = {};
  logs.forEach((log) => {
    if (!statsByDate[log.date]) {
      const total = timetableCounts.get(log.timetableId) || 0;
      statsByDate[log.date] = { total, completed: 0 };
    }
    if (log.completed) {
      statsByDate[log.date].completed++;
    }
  });
  return statsByDate;
};

